params {
    samples = null
    reference = null
    trim_enabled = true
    trim_quality = 20
    trim_length = 20
    trim_adapter = 'AGATCGGAAGAGC'
    outdir = "${launchDir}/results"
    trim_galore_container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0'
    fastqc_container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    multiqc_container = 'quay.io/biocontainers/multiqc@sha256:fb7d6625fb5adaed43ced8bd051a875038714180bcfcd7c8e467204f72882de9'
    read_trimming_audit_container = 'ghcr.io/gmiguelalves/helixforge-import-python:1.0.0@sha256:f09bbd79be8b6a14b3addebfad2134a692b2cb78d253b86d667fc423a34fe456'
    bowtie2_container = 'helixforge-chipseq-alignment-test'
    bowtie2_apptainer_container = null
    bowtie2_index_queue = null
    bowtie2_align_queue = null
}
process {
    executor = 'local'
    cpus = 1
    memory = 2.GB
    time = 10.m
    maxForks = 2
    withLabel: native_module {
        cpus = 1
        memory = 1.GB
        time = 10.m
    }
}
executor.queueSize = 2
trace { enabled = true; file = "${params.outdir}/trace.tsv"; overwrite = true }
timeline.enabled = false
report.enabled = false
dag.enabled = false
profiles { docker { docker.enabled = true } }
