process.executor = 'local'
executor.queueSize = 2
workDir = "${projectDir}/../../work"
params.fixture_dir = "${projectDir}/fixture_work"
params.outdir = "${projectDir}/results"
params.chipseq_db_count_provider = 'featurecounts'
params.chipseq_db_target_dir = null
params.featurecounts_container = null
params.featurecounts_apptainer_container = null
params.db_adapter_container = 'python:3.12.4-slim-bookworm'
params.deseq2_container = 'ghcr.io/gmiguelalves/omicsflow-deseq2:1.0.0'
params.deseq2_apptainer_container = 'docker://ghcr.io/gmiguelalves/omicsflow-deseq2:1.0.0'
params.db_count_queue = null
params.db_model_queue = null
params.db_contrast_queue = null
process { withLabel: native_module { cpus = 1; memory = 1.GB; time = 5.m } }
