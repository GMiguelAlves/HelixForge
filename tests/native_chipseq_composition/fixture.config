params.fixture_stub = false
process.executor = 'local'
executor.queueSize = 2
process {
    maxForks = 2
    withLabel: compatibility_adapter { cpus = 1; memory = 1.GB; time = 10.m }
    withLabel: native_module { cpus = 1; memory = 1.GB; time = 10.m }
    withLabel: db_high { cpus = 1; memory = { params.fixture_stub ? 1.GB : 4.GB }; time = 15.m }
}
timeline.enabled = false
report.enabled = false
dag.enabled = false
