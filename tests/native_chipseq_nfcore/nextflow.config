includeConfig '../../nextflow.config'
process.executor = 'local'
executor.queueSize = 2
params.chipseq_run_mode = 'consensus'
params.chipseq_consensus_method = 'nfcore_2_1'
params.chipseq_annotation_provider = 'homer_4_11'
params.chipseq_annotation_mode = 'homer_native'
params.chipseq_metadata_container = 'hf-nfcore-fixture-python:1.0'
params.chipseq_peak_annotation_container = 'hf-nfcore-fixture-python:1.0'
process {
    withLabel: native_module {
        cpus = 1
        memory = 1.GB
        time = 5.m
    }
}
docker.enabled = true
docker.runOptions = '-u 0:0'
conda.enabled = false
