process.executor = 'local'
executor.queueSize = 2
workDir = "${projectDir}/../../work"

params.fixture_dir = "${projectDir}/fixture_work"
params.outdir = "${projectDir}/results"
params.chipseq_run_mode = 'consensus'
params.chipseq_consensus_method = 'union'
params.chipseq_min_replicates = 2
params.chipseq_metadata_container = 'python:3.12.4-slim-bookworm'
params.consensus_container = null
params.consensus_apptainer_container = null
params.consensus_queue = null

process {
    withLabel: native_module {
        cpus = 1
        memory = 1.GB
        time = 5.m
    }
}
