manifest.nextflowVersion = '25.10.7'
nextflow.enable.moduleBinaries = true
params.outdir = "${projectDir}/results"
params.rna_manifest = null
params.chip_manifest = null
params.integrative_harmonization_policy = "${projectDir}/../../assets/integration/harmonization_policy.v1.json"
params.integrative_interpretation_policy = "${projectDir}/../../assets/integration/interpretation_policy.v1.json"
params.integrative_mark_roles = "${projectDir}/../../assets/integration/mark_roles.v1.tsv"
params.integrative_prioritization_context = "${projectDir}/../interpretation/fixture/prioritization_context.tsv"
params.integrative_functional_annotation = "${projectDir}/../integrative_legacy_characterization/fixture/inputs/functional_annotation.tsv"
params.integrative_top_candidates = 4
params.integrative_candidate_panels = 4
params.integrative_report_title = 'HelixForge Integrative Fixture Report'
params.integration_manifest_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
params.evidence_provider_container = params.integration_manifest_container
params.molecular_integration_container = params.integration_manifest_container
params.interpretation_container = params.integration_manifest_container
params.integrative_container = params.integration_manifest_container
process.executor = 'local'
process.shell = ['/bin/bash', '-ue']
process.beforeScript = "export PATH='${projectDir}/../../bin':\$PATH"
process {
    withLabel: integration_low { memory = 1.GB }
}
