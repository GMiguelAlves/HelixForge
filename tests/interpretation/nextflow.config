manifest.nextflowVersion = '25.10.7'
nextflow.enable.moduleBinaries = true
params.outdir = "${projectDir}/results"
params.rna_evidence = null
params.chip_evidence = null
params.harmonization_policy = "${projectDir}/../molecular_integration/fixture/policy.json"
params.interpretation_policy = "${projectDir}/../../assets/integration/interpretation_policy.v1.json"
params.mark_roles = "${projectDir}/../../assets/integration/mark_roles.v1.tsv"
params.prioritization_context = "${projectDir}/fixture/prioritization_context.tsv"
params.molecular_integration_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
params.interpretation_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
process.executor = 'local'
process.shell = ['/bin/bash', '-ue']
process.beforeScript = "export PATH='${projectDir}/../../bin':\$PATH"
process {
    withLabel: integration_low {
        memory = 1.GB
    }
}
