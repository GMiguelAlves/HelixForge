    chip_manifest = null
    integrative_harmonization_policy = "${projectDir}/assets/integration/harmonization_policy.v1.json"
    integrative_interpretation_policy = "${projectDir}/assets/integration/interpretation_policy.v1.json"
    integrative_mark_roles = "${projectDir}/assets/integration/mark_roles.v1.tsv"
    integrative_prioritization_context = "${projectDir}/assets/integration/prioritization_context.template.tsv"
    integrative_functional_annotation = "${projectDir}/assets/integration/functional_annotation.template.tsv"
