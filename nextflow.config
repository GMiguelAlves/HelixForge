    rnaseq_report_context_container = 'python:3.12.4-slim-bookworm'
    rnaseq_report_container = 'ghcr.io/gmiguelalves/helixforge-rnaseq-report:1.0.0@sha256:ec8818c48c91e2fe501c01ffa27291e92662ddd6d8ab9eb1bc9e6afc99e6f863'
