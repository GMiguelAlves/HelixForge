manifest {
    name            = 'OmicsFlow'
    author          = 'OmicsFlow contributors'
    description     = 'Compatibility-first orchestration of RNA-seq, ChIP-seq, and integrative pipelines'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0-dev'
}

nextflow.enable.moduleBinaries = true

params {
    workflow          = 'all'
    outdir            = "${projectDir}/results"
    legacy_dry_run    = false
    rnaseq_native_qc  = true
    rnaseq_native_alignment = true
    rnaseq_native_quantification = true
    rnaseq_native_import = true
    rnaseq_native_de = true
    rnaseq_analysis_mode = 'config'
    rnaseq_run_mode = 'full'
    rnaseq_native_trim_galore = true
    trim_galore_container = 'quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0'
    fastqc_container  = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    merge_fastq_container = 'debian:12.5-slim'
    multiqc_container = 'quay.io/biocontainers/multiqc:1.17--pyhdfd78af_1'
    star_container = 'community.wave.seqera.io/library/htslib_samtools_star_gawk:ae438e9a604351a4'
    star_apptainer_container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/26/268b4c9c6cbf8fa6606c9b7fd4fafce18bf2c931d1a809a0ce51b105ec06c89d/data'
    star_index_queue = null
    star_align_queue = null
    salmon_container = 'quay.io/biocontainers/salmon@sha256:f83ebb158845ee8138d793347f83b92c75e83c58dd8f4600c6fea2a2453ef08e'
    salmon_apptainer_container = 'https://depot.galaxyproject.org/singularity/salmon:1.10.3--h6dccd9a_2'
    salmon_index_queue = null
    salmon_quant_queue = null
    import_source_container = 'ghcr.io/gmiguelalves/omicsflow-import-python:1.0.0'
    tx2gene_container = 'ghcr.io/gmiguelalves/omicsflow-import:1.0.0'
    tx2gene_apptainer_container = 'docker://ghcr.io/gmiguelalves/omicsflow-import:1.0.0'
    tx2gene_queue = null
    tximport_container = 'ghcr.io/gmiguelalves/omicsflow-import:1.0.0'
    tximport_apptainer_container = 'docker://ghcr.io/gmiguelalves/omicsflow-import:1.0.0'
    tximport_queue = null
    star_import_container = 'ghcr.io/gmiguelalves/omicsflow-import-python:1.0.0'
    star_import_apptainer_container = 'docker://ghcr.io/gmiguelalves/omicsflow-import-python:1.0.0'
    star_import_queue = null
    de_adapter_container = 'ghcr.io/gmiguelalves/omicsflow-import-python:1.0.0'
    deseq2_container = 'ghcr.io/gmiguelalves/omicsflow-deseq2:1.0.0'
    deseq2_apptainer_container = 'docker://ghcr.io/gmiguelalves/omicsflow-deseq2:1.0.0'
    deseq2_model_queue = null
    deseq2_contrast_queue = null
    rnaseq_config     = "${projectDir}/pipelines/rnaseq/legacy/config/pipeline_config.sh"
    chipseq_config    = "${projectDir}/pipelines/chipseq/legacy/config/pipeline_config.sh"
    integrative_config = "${projectDir}/pipelines/integrative/legacy/config/pipeline_config.sh"
}

includeConfig 'conf/base.config'

profiles {
    local {
        includeConfig 'profiles/local.config'
    }
    slurm {
        includeConfig 'profiles/slurm.config'
    }
    docker {
        includeConfig 'profiles/docker.config'
    }
    singularity {
        includeConfig 'profiles/singularity.config'
    }
    apptainer {
        includeConfig 'profiles/apptainer.config'
    }
    conda {
        includeConfig 'profiles/conda.config'
    }
    test {
        includeConfig 'profiles/test.config'
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
    fields  = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
