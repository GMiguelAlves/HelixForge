manifest {
    name            = 'HelixForge'
    author          = 'HelixForge contributors'
    description     = 'Compatibility-first orchestration of RNA-seq, ChIP-seq, and integrative pipelines'
    mainScript      = 'main.nf'
    nextflowVersion = '25.10.7'
    version         = '1.0.0-rc.1'
}

nextflow.enable.moduleBinaries = true

params {
    workflow          = 'all'
    outdir            = "${projectDir}/results"
    rnaseq_native_qc  = true
    rnaseq_trim_quality = null
    rnaseq_trim_length  = null
    rnaseq_native_alignment = true
    rnaseq_native_quantification = true
    rnaseq_native_import = true
    rnaseq_native_de = true
    rnaseq_report_enabled = false
    rnaseq_report_genes = null
    rnaseq_report_provider = 'candidate_genes_v1'
    rnaseq_report_title = null
    rnaseq_report_expression_unit = null
    rnaseq_report_outdir = null
    rnaseq_report_life_stage_levels = null
    rnaseq_report_stage_synonym_map = null
    rnaseq_report_organism_specific = null
    rnaseq_de_spec = null
    rnaseq_analysis_mode = 'quantification'
    rnaseq_run_mode = 'full'
    rnaseq_native_trim_galore = true
    rnaseq_import_policy = 'production_v1'
    chipseq_run_mode = 'full'
    chipseq_min_mapq = null
    chipseq_include_flags = 0
    chipseq_exclude_flags = null
    chipseq_region = null
    chipseq_duplicate_mode = 'none'
    chipseq_blacklist = null
    chipseq_blacklist_overlap_mode = 'fragment'
    chipseq_sort_final_if_needed = false
    chipseq_peak_caller = null
    chipseq_peak_type = null
    chipseq_effective_genome_size = null
    chipseq_peak_q_value = null
    chipseq_peak_p_value = null
    chipseq_peak_format = null
    chipseq_peak_duplicate_policy = 'all'
    chipseq_peak_additional_args = null
    chipseq_peak_output_dir = null
    chipseq_frip_unit = 'layout'
    chipseq_frip_min_mapq = 0
    chipseq_frip_include_flags = 0
    chipseq_frip_additional_exclude_flags = 0
    chipseq_frip_exclude_unmapped = true
    chipseq_frip_exclude_secondary = true
    chipseq_frip_exclude_supplementary = true
    chipseq_frip_exclude_qc_fail = true
    chipseq_frip_duplicate_handling = 'include'
    chipseq_frip_require_proper_pair = true
    chipseq_frip_overlap_strategy = 'any_base'
    chipseq_frip_blacklist_policy = 'bam_preprocessed'
    chipseq_consensus_method = null
    chipseq_min_replicates = null
    chipseq_replicate_mode = 'biological'
    chipseq_replicate_policy = 'require_premerged'
    chipseq_consensus_require_same_caller = true
    chipseq_idr_threshold = null
    chipseq_idr_rank_metric = null
    chipseq_db_spec = null
    chipseq_db_count_provider = 'featurecounts'
    chipseq_db_target_dir = null
    chipseq_annotation_peaks = null
    chipseq_annotation_peak_manifest = null
    chipseq_annotation_reference = null
    chipseq_annotation_reference_manifest = null
    chipseq_annotation_gtf = null
    chipseq_annotation_provider = 'python_interval_v1'
    chipseq_annotation_mode = 'overlap_priority'
    chipseq_annotation_overlap_mode = 'any'
    chipseq_annotation_promoter_upstream = 2000
    chipseq_annotation_promoter_downstream = 500
    chipseq_annotation_max_tss_distance = null
    chipseq_annotation_feature_priority = 'promoter,exon,intron,downstream,gene'
    chipseq_annotation_gene_assignment = 'first'
    chipseq_annotation_strand_aware = false
    chipseq_annotation_intergenic_policy = 'retain'
    chipseq_tracks_input_manifest = null
    chipseq_track_provider = 'deeptools_bamcoverage_v1'
    chipseq_track_format = 'bigwig'
    chipseq_track_bin_size = 10
    chipseq_track_normalization = 'CPM'
    chipseq_track_effective_genome_size = null
    chipseq_track_scale_factor = 1.0
    chipseq_track_extend_reads = false
    chipseq_track_fragment_mode = 'reads'
    chipseq_track_strand = 'unstranded'
    chipseq_track_additional_filters = 'none'
    chipseq_track_aggregate = true
    chipseq_track_aggregate_scope = 'condition_target'
    chipseq_report_input_manifest = null
    chipseq_report_provider = 'html_v1'
    chipseq_report_title = 'ChIP-seq final report'
    chipseq_report_language = 'en'
    integration_manifest_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
    evidence_provider_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
    molecular_integration_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
    interpretation_container = 'python:3.12.10-slim@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db'
    chipseq_context_container = 'debian:12.5-slim'
    chipseq_metadata_container = 'python:3.12.4-slim-bookworm'
    rnaseq_context_container = 'debian:12.5-slim'
    rnaseq_metadata_container = 'python:3.12.4-slim-bookworm'
