{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixforge.dev/schemas/nextflow-params.json",
  "title": "HelixForge parameters",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "string",
      "enum": ["rnaseq", "chipseq", "integrative", "all"],
      "default": "all"
    },
    "outdir": { "type": "string" },
    "rnaseq_native_qc": {
      "type": "boolean",
      "default": true,
      "description": "Required. The retired legacy RNA-seq QC fallback is no longer scheduled."
    },
    "rnaseq_trim_quality": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null,
      "description": "Optional explicit override for the trim quality sourced from pipeline_config.sh."
    },
    "rnaseq_trim_length": {
      "type": ["integer", "null"],
      "minimum": 0,
      "default": null,
      "description": "Optional explicit override for the minimum trim length sourced from pipeline_config.sh."
    },
    "rnaseq_native_alignment": {
      "type": "boolean",
      "default": true,
      "description": "Use the generic Alignment API with native STAR when QUANT_METHOD=star."
    },
    "rnaseq_native_quantification": {
      "type": "boolean",
      "default": true,
      "description": "Use the generic Quantification API with native Salmon."
    },
    "rnaseq_analysis_mode": {
      "type": "string",
      "enum": ["config", "alignment", "quantification", "both"],
      "default": "quantification",
      "description": "Run the configured provider, STAR only, Salmon only, or both independent layers."
    },
    "rnaseq_native_trim_galore": {
      "type": "boolean",
      "default": true,
      "description": "Required. Run RNA-seq run-level trimming as a native Nextflow process."
