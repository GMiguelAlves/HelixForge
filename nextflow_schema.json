{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsflow.dev/schemas/nextflow-params.json",
  "title": "OmicsFlow parameters",
  "type": "object",
  "properties": {
    "workflow": {
      "type": "string",
      "enum": ["rnaseq", "chipseq", "integrative", "all"],
      "default": "all"
    },
    "outdir": { "type": "string" },
    "legacy_dry_run": { "type": "boolean", "default": false },
    "rnaseq_native_qc": {
      "type": "boolean",
      "default": true,
      "description": "Run the RNA-seq quality-control layer as native Nextflow processes."
    },
    "rnaseq_native_alignment": {
      "type": "boolean",
      "default": true,
      "description": "Use the generic Alignment API with native STAR when QUANT_METHOD=star."
    },
    "rnaseq_native_quantification": {
      "type": "boolean",
      "default": true,
      "description": "Use the generic Quantification API with native Salmon."
    },
    "rnaseq_analysis_mode": {
      "type": "string",
      "enum": ["config", "alignment", "quantification", "both"],
      "default": "config",
      "description": "Run the configured provider, STAR only, Salmon only, or both independent layers."
    },
    "rnaseq_native_trim_galore": {
      "type": "boolean",
      "default": true,
      "description": "Run RNA-seq run-level trimming as a native Nextflow process."
    },
    "trim_galore_container": {
      "type": "string",
      "default": "quay.io/biocontainers/trim-galore:0.6.10--hdfd78af_0"
    },
    "fastqc_container": {
      "type": "string",
      "default": "quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"
    },
    "merge_fastq_container": {
      "type": "string",
      "default": "debian:12.5-slim"
    },
    "multiqc_container": {
      "type": "string",
      "default": "quay.io/biocontainers/multiqc:1.17--pyhdfd78af_1"
    },
    "star_container": {
      "type": "string",
      "default": "community.wave.seqera.io/library/htslib_samtools_star_gawk:ae438e9a604351a4"
    },
    "star_apptainer_container": {
      "type": "string",
      "default": "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/26/268b4c9c6cbf8fa6606c9b7fd4fafce18bf2c931d1a809a0ce51b105ec06c89d/data"
    },
    "star_index_queue": { "type": ["string", "null"], "default": null },
    "star_align_queue": { "type": ["string", "null"], "default": null },
    "salmon_container": {
      "type": "string",
      "default": "quay.io/biocontainers/salmon@sha256:f83ebb158845ee8138d793347f83b92c75e83c58dd8f4600c6fea2a2453ef08e"
    },
    "salmon_apptainer_container": {
      "type": "string",
      "default": "https://depot.galaxyproject.org/singularity/salmon:1.10.3--h6dccd9a_2"
    },
    "salmon_index_queue": { "type": ["string", "null"], "default": null },
    "salmon_quant_queue": { "type": ["string", "null"], "default": null },
    "chipseq_run_mode": {
      "type": "string",
      "enum": ["qc", "alignment", "post_alignment", "peaks", "full"],
      "default": "full"
    },
    "chipseq_native_peak_calling": { "type": "boolean", "default": true },
    "chipseq_peak_caller": { "type": ["string", "null"], "enum": ["macs3", null], "default": null },
    "chipseq_peak_type": { "type": ["string", "null"], "enum": ["narrow", "broad", null], "default": null },
    "chipseq_effective_genome_size": { "type": ["number", "integer", "null"], "exclusiveMinimum": 0, "default": null },
    "chipseq_peak_q_value": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1, "default": null },
    "chipseq_peak_p_value": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1, "default": null },
    "chipseq_peak_format": { "type": ["string", "null"], "enum": ["BAM", "BAMPE", null], "default": null },
    "chipseq_peak_duplicate_policy": {
      "oneOf": [
        { "type": "string", "pattern": "^(all|auto|[1-9][0-9]*)$" },
        { "type": "integer", "minimum": 1 }
      ],
      "default": "all"
    },
    "chipseq_peak_additional_args": { "type": ["string", "null"], "default": null },
    "chipseq_peak_output_dir": { "type": ["string", "null"], "default": null },
    "rnaseq_config": { "type": "string" },
    "chipseq_config": { "type": "string" },
    "integrative_config": { "type": "string" }
  },
  "required": ["workflow"]
}
