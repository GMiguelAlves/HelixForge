docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
conda.enabled = false

process.executor = 'slurm'

executor {
    queueSize = 5
    submitRateLimit = '2 sec'
}

process {
    maxForks = 5

    withLabel: benchmark_low {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }
    withLabel: benchmark_medium {
        cpus = 4
        memory = 16.GB
        time = 8.h
    }
    withLabel: benchmark_high {
        cpus = 8
        memory = 24.GB
        time = 12.h
    }
    withLabel: benchmark_simulation {
        cpus = 1
        memory = 16.GB
        time = 12.h
        maxForks = 3
    }
    withLabel: compatibility_adapter {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    withLabel: native_module {
        cpus = 4
        memory = 16.GB
        time = 8.h
    }
    withLabel: native_high {
        cpus = 8
        memory = 24.GB
        time = 12.h
    }
    withLabel: alignment_index {
        cpus = 4
        memory = 12.GB
        time = 6.h
    }
    withLabel: alignment_high {
        cpus = 8
        memory = 24.GB
        time = 12.h
    }
    withLabel: bam_processing {
        cpus = 4
        memory = 16.GB
        time = 6.h
    }
    withLabel: peak_calling {
        cpus = 4
        memory = 16.GB
        time = 4.h
    }
    withLabel: peak_qc {
        cpus = 4
        memory = 16.GB
        time = 4.h
    }
    withLabel: peak_qc_low {
        cpus = 2
        memory = 8.GB
        time = 4.h
    }
    withLabel: consensus {
        cpus = 4
        memory = 16.GB
        time = 4.h
    }
    withLabel: consensus_low {
        cpus = 2
        memory = 8.GB
        time = 4.h
    }
}
