docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
conda.enabled = false

process.executor = 'slurm'
executor {
    queueSize = 5
    submitRateLimit = '2 sec'
}

// Resource envelope for the eight-library GSE52778 biological benchmark.
// The synthetic Slurm profile deliberately caps native tasks at 15 minutes and
// must not be reused here: Trim Galore alone needs longer for the full libraries.
process {
    withLabel: compatibility_adapter {
        cpus = 1
        memory = 2.GB
        time = 10.m
    }
    withLabel: native_module {
        cpus = 1
        memory = 2.GB
        time = 15.m
    }

    // Keep the completed contexts, metadata, raw FastQC and reference tasks on
    // the exact resource envelope of the first attempt so -resume can reuse
    // their hashes. Override only downstream tasks that have not completed.
    withName: 'RNASEQ:RNASEQ_QC:TRIM_GALORE' {
        cpus = 2
        memory = 8.GB
        time = 4.h
    }
    withName: 'RNASEQ:RNASEQ_QC:FASTQC_TRIMMED' {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }
    withName: 'RNASEQ:RNASEQ_QC:MERGE_FASTQ' {
        cpus = 2
        memory = 8.GB
        time = 6.h
    }
    withName: 'RNASEQ:RNASEQ_QC:FASTQC_MERGED' {
        cpus = 2
        memory = 4.GB
        time = 2.h
    }
    withName: 'RNASEQ:RNASEQ_QC:MULTIQC' {
        cpus = 2
        memory = 8.GB
        time = 2.h
    }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:TRANSCRIPTOME_INDEX:SALMON_INDEX' {
        cpus = 8
        memory = 32.GB
        time = 12.h
    }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:QUANTIFICATION:SALMON_QUANT' {
        cpus = 4
        memory = 16.GB
        time = 8.h
    }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:IMPORT:TX2GENE_BUILD' {
        cpus = 2
        memory = 16.GB
        time = 6.h
    }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:IMPORT:SALMON_IMPORT' {
        cpus = 2
        memory = 24.GB
        time = 6.h
    }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:DIFFERENTIAL_EXPRESSION:DESEQ2_MODEL' {
        cpus = 4
        memory = 48.GB
        time = 12.h
    }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:DIFFERENTIAL_EXPRESSION:DESEQ2_CONTRAST' {
        cpus = 2
        memory = 16.GB
        time = 4.h
    }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:RNASEQ_REPORT:RNASEQ_GENE_REPORT' {
        cpus = 2
        memory = 24.GB
        time = 4.h
    }
}
