process.executor = 'slurm'
process.queue = 'general'

executor {
    queueSize = 5
    submitRateLimit = '2 sec'
}

process {
    withLabel: integration_low {
        cpus = 1
        memory = '2 GB'
        time = '30 min'
    }

    withLabel: evidence_low {
        cpus = 1
        memory = '2 GB'
        time = '30 min'
    }
}
