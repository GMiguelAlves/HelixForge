docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
conda.enabled = false

process.executor = 'slurm'
executor {
    queueSize = 5
    submitRateLimit = '2 sec'
}

process {
    maxForks = 5

    withLabel: compatibility_adapter { cpus = 1; memory = 2.GB; time = 30.m }
    withLabel: native_module { cpus = 2; memory = 8.GB; time = 4.h }
    withLabel: native_high { cpus = 8; memory = 32.GB; time = 12.h }
    withLabel: alignment_index { cpus = 8; memory = 32.GB; time = 12.h }
    withLabel: alignment_high { cpus = 8; memory = 32.GB; time = 12.h }
    withLabel: bam_processing { cpus = 4; memory = 16.GB; time = 8.h }
    withLabel: peak_calling { cpus = 4; memory = 16.GB; time = 6.h }
    withLabel: peak_qc { cpus = 4; memory = 16.GB; time = 6.h }
    withLabel: peak_qc_low { cpus = 2; memory = 8.GB; time = 4.h }
    withLabel: consensus { cpus = 4; memory = 16.GB; time = 6.h }
    withLabel: consensus_low { cpus = 2; memory = 8.GB; time = 4.h }
    withLabel: db_high { cpus = 4; memory = 32.GB; time = 12.h }

    withName: 'RNASEQ:RNASEQ_QC:TRIM_GALORE' { cpus = 2; memory = 8.GB; time = 6.h }
    withName: 'RNASEQ:RNASEQ_QC:FASTQC_TRIMMED' { cpus = 2; memory = 4.GB; time = 3.h }
    withName: 'RNASEQ:RNASEQ_QC:MERGE_FASTQ' { cpus = 2; memory = 8.GB; time = 8.h }
    withName: 'RNASEQ:RNASEQ_QC:FASTQC_MERGED' { cpus = 2; memory = 4.GB; time = 3.h }
    withName: 'RNASEQ:RNASEQ_QC:MULTIQC' { cpus = 2; memory = 8.GB; time = 3.h }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:TRANSCRIPTOME_INDEX:SALMON_INDEX' { cpus = 8; memory = 32.GB; time = 12.h }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:QUANTIFICATION:SALMON_QUANT' { cpus = 4; memory = 16.GB; time = 10.h }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:IMPORT:TX2GENE_BUILD' { cpus = 2; memory = 16.GB; time = 6.h }
    withName: 'RNASEQ:RNASEQ_ALIGNMENT_QUANTIFICATION:IMPORT:SALMON_IMPORT' { cpus = 2; memory = 24.GB; time = 6.h }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:DIFFERENTIAL_EXPRESSION:DESEQ2_MODEL' { cpus = 4; memory = 48.GB; time = 12.h }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:DIFFERENTIAL_EXPRESSION:DESEQ2_CONTRAST' { cpus = 2; memory = 16.GB; time = 4.h }
    withName: 'RNASEQ:RNASEQ_DIFFERENTIAL_EXPRESSION:RNASEQ_REPORT:RNASEQ_GENE_REPORT' { cpus = 2; memory = 24.GB; time = 4.h }
}
