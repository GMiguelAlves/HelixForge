/*
 * Benchmark-only runtime selection for the R differential-binding boundary.
 * It deliberately leaves every upstream ChIP-seq process environment intact.
 */
process {
    withName: 'CHIPSEQ:CHIPSEQ_NATIVE_FOUNDATION:DIFFERENTIAL_BINDING:DESEQ2_DB_MODEL' {
        beforeScript = 'export PATH=/scratch/HELIXFORGE_WORKSPACE/helixforge-rnaseq-benchmark-20260825/envs/r-analysis-rc/bin:$PATH'
    }
    withName: 'CHIPSEQ:CHIPSEQ_NATIVE_FOUNDATION:DIFFERENTIAL_BINDING:DESEQ2_DB_CONTRAST' {
        beforeScript = 'export PATH=/scratch/HELIXFORGE_WORKSPACE/helixforge-rnaseq-benchmark-20260825/envs/r-analysis-rc/bin:$PATH'
    }
}
