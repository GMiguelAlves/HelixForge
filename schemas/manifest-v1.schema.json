{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omicsflow.dev/schemas/manifest-v1.json",
  "title": "OmicsFlow output manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "pipeline", "pipeline_version", "reference_id", "artifacts"],
  "properties": {
    "manifest_version": { "const": "1" },
    "pipeline": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "reference_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "format"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

