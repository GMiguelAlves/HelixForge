{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixforge.dev/schemas/manifest-v1.json",
  "title": "HelixForge native manifest envelope v1",
  "description": "Common envelope shared by native API manifests. Domain-specific fields remain extensible in v1.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "type", "id", "status"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1(\\.[0-9]+)?$" },
    "type": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["complete", "complete_empty", "incomplete", "not_implemented", "stub", "failed"]
    },
    "record_id": { "type": ["string", "null"] },
    "sample_id": { "type": ["string", "null"] },
    "dataset": { "type": ["string", "null"] },
    "condition": { "type": ["string", "null"] },
    "target": { "type": ["string", "null"] },
    "genome_id": { "type": ["string", "null"] },
    "build": { "type": ["string", "null"] },
    "reference_sha256": { "type": ["string", "null"] },
    "parameters": { "type": "object" },
    "artifacts": { "type": ["object", "array"] },
    "execution": { "type": "object" },
    "versions": { "type": ["object", "array"] },
    "upstream_manifests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "id": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "sha256": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
