{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://helixforge.dev/schemas/interpretation/interpretation-manifest.schema.json","title":"HelixForge Interpretation Manifest v1","type":"object","additionalProperties":false,
