{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://helixforge.dev/schemas/integration-engine/integration-manifest.schema.json",
  "title":"HelixForge Molecular Evidence Integration v1",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","integration_model_version","type","id","status","reference","input_evidence_manifests","harmonization_manifest_id","harmonization_manifest_checksum","datasets","record_counts","provenance"],
  "properties":{
    "schema_version":{"const":"1.0"}, "integration_model_version":{"const":"1.0"}, "type":{"const":"molecular_evidence_integration"},
    "id":{"type":"string","minLength":1}, "status":{"enum":["complete","stub"]}, "reference":{"type":"object"},
    "input_evidence_manifests":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["id","assay"]}},
    "harmonization_manifest_id":{"type":"string","minLength":1}, "harmonization_manifest_checksum":{"$ref":"#/$defs/checksum"}, "datasets":{"type":"array","items":{"$ref":"#/$defs/dataset"}},
    "record_counts":{"type":"object","required":["canonical_genes","long_observations","peak_groups"]}, "provenance":{"type":"object"}
  },
  "$defs":{"checksum":{"type":"object","required":["algorithm","value"],"properties":{"algorithm":{"const":"sha256"},"value":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"dataset":{"type":"object","required":["dataset_type","path","records","checksum"],"properties":{"dataset_type":{"enum":["master_evidence_long","master_evidence","peak_aggregation"]},"path":{"type":"string"},"records":{"type":"integer","minimum":0},"checksum":{"$ref":"#/$defs/checksum"}}}}
}
