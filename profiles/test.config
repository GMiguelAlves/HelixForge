process.executor = 'local'
executor.queueSize = 2
params.outdir = "${projectDir}/results/test"
params.rnaseq_de_spec = "${projectDir}/tests/fixtures/native_de/analysis_spec.json"
params.rnaseq_counts_from_abundance = 'lengthScaledTPM'
params.rnaseq_library_protocol = 'full_length'

process {
    withLabel: legacy_orchestrator {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }

    withLabel: compatibility_adapter {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }

    withLabel: native_module {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }
}
