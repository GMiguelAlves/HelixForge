process.executor = 'local'
executor.queueSize = 2
params.outdir = "${projectDir}/results/test"
params.rnaseq_de_spec = "${projectDir}/tests/fixtures/native_de/analysis_spec.json"
params.rnaseq_counts_from_abundance = 'lengthScaledTPM'
params.rnaseq_library_protocol = 'full_length'
params.chipseq_peak_caller = 'macs3'
params.chipseq_peak_type = 'narrow'
params.chipseq_effective_genome_size = 30000
params.chipseq_peak_q_value = 0.5
params.chipseq_peak_format = 'BAMPE'
params.chipseq_peak_duplicate_policy = 'all'
params.chipseq_consensus_method = 'union'
params.chipseq_min_replicates = 2
params.chipseq_db_spec = "${projectDir}/assets/chipseq_db_spec.example.json"

process {
    withLabel: legacy_orchestrator {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }

    withLabel: compatibility_adapter {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }

    withLabel: native_module {
        cpus   = 1
        memory = 1.GB
        time   = 5.m
    }
}
